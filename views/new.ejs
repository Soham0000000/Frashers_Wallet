<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add payment | Payment history</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="page-shell form-shell"><a class="back-link" href="/chats">&#8592; Back to history</a><div class="form-heading"><p class="eyebrow">NEW TRANSACTION</p><h1>Add payment</h1><p class="subtitle">Enter the details of your completed payment.</p></div>
    <form action="/chats" method="post" class="payment-form">
        <label>Paid by<input type="text" placeholder="Your name" name="from" required></label><label>Paid to<input type="text" placeholder="Recipient name" name="to" required></label><label>Amount<input type="number" placeholder="0.00" name="amount" min="1" step="0.01" required></label><label>Semester<select name="semester" required><option value="" disabled selected>Select semester</option><option value="2nd Semester">2nd Semester</option><option value="5th Semester">5th Semester</option><option value="7th Semester">7th Semester</option></select></label><label>Food preference<select name="food_preference"><option value="">Not specified</option><option value="Veg">Veg</option><option value="Non-Veg">Non-Veg</option></select></label><label>Payment method<select name="payment_method"><option>UPI</option><option>Card</option><option>Net banking</option><option>Wallet</option><option>Cash</option></select></label><label>Note <span class="optional">(optional)</span><textarea name="msg" placeholder="What was this payment for?"></textarea></label><button class="btn form-submit" type="submit">Save payment <span>&#8594;</span></button>
    </form>
    </main>
</body>
</html>